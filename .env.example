# Shared Neon Serverless database
DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/openreply?sslmode=require

# Public application URL
APP_BASE_URL=https://app.example.com

# Single administrator
ADMIN_LOGIN=admin
ADMIN_PASSWORD_PEPPER=base64url-32-byte-secret
ADMIN_PASSWORD_VERIFIER=base64url-hmac-sha256-verifier
SESSION_SIGNING_KEY=base64url-32-byte-secret

# Encryption and privacy
ENCRYPTION_KEY=base64url-32-byte-secret
OAUTH_STATE_KEY=base64url-32-byte-secret
IP_HASH_SALT=base64url-32-byte-secret

# Meta / Instagram Login
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://app.example.com/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=replace-with-random-token
META_GRAPH_API_VERSION=v25.0

# Local browser acceptance tests only
E2E_BASE_URL=https://app.example.com
E2E_ADMIN_LOGIN=admin
E2E_ADMIN_PASSWORD=not-for-production-env-files
E2E_REPORT_SLUG=public-report-slug
