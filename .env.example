# InstaScaler local configuration — use .env locally, never commit live values.
# Neon Serverless: paste the pooled connection string from Neon.
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST.neon.tech/instascaler?sslmode=require
# Optional isolated, migrated test database; never use the application database.
# QUIZ_TEST_DATABASE_URL=postgresql://TEST_USER:TEST_PASSWORD@127.0.0.1:5432/instascaler_test?sslmode=disable

# Public application URL. For Cloudflare use your workers.dev or custom domain URL.
APP_BASE_URL=https://YOUR-INSTASCALER-DOMAIN.example

# Single administrator — generate real values with scripts/generate-admin-secrets.mjs.
ADMIN_LOGIN=YOUR_ADMIN_LOGIN
ADMIN_PASSWORD_PEPPER=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
ADMIN_PASSWORD_VERIFIER=REPLACE_WITH_HMAC_SHA256_PASSWORD_VERIFIER
SESSION_SIGNING_KEY=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
SCHEDULER_BOOTSTRAP_TOKEN=REPLACE_WITH_BASE64URL_32_BYTE_SECRET

# Encryption and privacy.
ENCRYPTION_KEY=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
OAUTH_STATE_KEY=REPLACE_WITH_BASE64URL_32_BYTE_SECRET
IP_HASH_SALT=REPLACE_WITH_BASE64URL_32_BYTE_SECRET

# Meta / Instagram Login — copy values from Meta for Developers.
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=https://YOUR-INSTASCALER-DOMAIN.example/api/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_TOKEN
META_GRAPH_API_VERSION=v25.0

# Local browser acceptance tests only.
E2E_BASE_URL=https://YOUR-INSTASCALER-DOMAIN.example
E2E_ADMIN_LOGIN=YOUR_ADMIN_LOGIN
E2E_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
E2E_REPORT_SLUG=YOUR_PUBLIC_REPORT_SLUG
