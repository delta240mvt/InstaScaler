{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instascaler-jobs",
  "main": "workers/jobs/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "EVENT_JOURNAL", "bucket_name": "instascaler-event-journal" }],
  "queues": { "consumers": [{ "queue": "instascaler-events", "max_batch_size": 10, "max_batch_timeout": 5 }] }
  ,"triggers": { "crons": ["7 * * * *", "0 5 * * *", "0 6 * * *", "0 7 * * *", "20 3 * * *"] }
  ,"durable_objects": { "bindings": [{ "name": "ACCOUNT_RATE_LIMITER", "class_name": "AccountRateLimiter" }] }
  ,"migrations": [{ "tag": "v1", "new_classes": ["AccountRateLimiter"] }]
}
