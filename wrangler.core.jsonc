{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instascaler-core",
  "main": "workers/core/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "services": [{ "binding": "JOBS_API", "service": "instascaler-jobs", "entrypoint": "ManualMessages" }],
  "durable_objects": {
    "bindings": [{ "name": "LOGIN_THROTTLE", "class_name": "LoginThrottle" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginThrottle"] }],
  "r2_buckets": [{ "binding": "EVENT_JOURNAL", "bucket_name": "instascaler-event-journal" }],
  "queues": { "producers": [{ "binding": "INSTAGRAM_EVENTS", "queue": "instascaler-events" }] }
}
