{
  "name": "openreply",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build:web": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "cf:dev:core": "wrangler dev --config wrangler.core.jsonc",
    "cf:dev:jobs": "wrangler dev --config wrangler.jobs.jsonc",
    "cf:deploy:web": "opennextjs-cloudflare deploy --config wrangler.web.jsonc",
    "cf:deploy:core": "wrangler deploy --config wrangler.core.jsonc",
    "cf:deploy:jobs": "wrangler deploy --config wrangler.jobs.jsonc",
    "cf:typegen": "wrangler types cloudflare-env.d.ts --config wrangler.jobs.jsonc"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "hono": "^4.12.33",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
